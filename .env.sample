# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored; this sample is safe to commit.

NODE_ENV=development
APP_PORT=3001
APP_NAME="HubLib Service"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
# BACKEND_DOMAIN=https://api.hulib.org
BACKEND_DOMAIN=https://localhost:3001

# Comma-separated list of allowed CORS origins (HTTP + WS gateways).
# Must be scheme + host + optional port, no trailing slash. No wildcards.
# Leave empty to disable cross-origin requests.
# Local:  http://localhost:3000
# Prod:   https://hulib.org,https://www.hulib.org
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=hulib-original
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

DATABASE_URL="postgresql://postgres@localhost:5432/hulib-original"

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-southeast-1
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=365d
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=365d
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=365d

DATA_FOLDER=./data

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

WORKER_HOST=redis://redis:6379/1

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

SMS_API_KEY=
SMS_API_SECRET=
SMS_DEFAULT_PHONE_NUMBER=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=false
REDIS_CA=
REDIS_KEY=
REDIS_CERT=
