<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
    <style>
      .container {
        width: 100%;
        max-width: 630px;
        margin: auto;
        padding: 0 10px;
      }
      .content-area {
        padding: 0 40px;
      }

      @media only screen and (max-width: 600px) {
        .content-area {
          padding: 0 20px !important;
        }
      }
    </style>
  </head>
  <body style='margin: auto; font-family: "Georgia", sans-serif'>
    <div class="container" style="background: white;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 630px;">
        <tr>
          <td class="content-area" style="padding: 40px 50px 0 50px;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
              <tr>
                <td style="padding-bottom: 20px; text-align: center; color: #010D26;">
                  <p style="margin: 0; font-size: 24px;">{{title}}</p>
                  <h1 style="margin: 0; font-size: 24px; font-weight: bold; font-style: italic;">{{subTitle}}</h1>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 16px;">
                  <p style="margin: 0; font-size: 15px; color: #010D26;">
                    {{dear}} <strong style="font-weight: 700; font-style: italic;">{{fullName}}</strong>,
                  </p>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 16px; color: #010D26;">
                  <p style="margin: 0; font-size: 15px;">{{p1}}</p>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 16px; color: #010D26;">
                  <p style="margin: 0; font-size: 15px;">{{p2}}</p>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 32px; color: #010D26;">
                  <p style="margin: 0; font-size: 15px;">{{p3}}</p>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 40px; text-align: center;">
                  <a
                    href="{{buttonUrl}}"
                    style="display: inline-block; padding: 12px 30px; background-color: #0442BF; color: #ffffff; border-radius: 24px; font-weight: bold; font-size: 16px; text-decoration: none;"
                  >{{buttonLabel}}</a>
                </td>
              </tr>

              <tr>
                <td style="padding-bottom: 40px;">
                  <p style="margin: 0; font-size: 15px; color: #010D26;">The HuLib Team</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding: 20px 0 60px 0; border-top: 2px solid #E3E4E5;" align="center">
            <p style="margin: 20px 0 0 0; font-size: 16px; color: #2E3032;">
              Website:
              <a href="{{webAppLink}}" style="color: #0442BF; text-decoration: underline; font-weight: bold;">
                HuLib | Landing Page
              </a>
            </p>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
