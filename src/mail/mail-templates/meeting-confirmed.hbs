<!DOCTYPE html>
<html lang='{{locale}}'>
  <head><meta charset='UTF-8' /><meta name='viewport' content='width=device-width, initial-scale=1' /><title>{{title}}</title></head>
  <body style='margin:0;background:#f5f6f7;font-family:Arial,sans-serif;color:#010d26'>
    <table role='presentation' width='100%' cellspacing='0' cellpadding='0'><tr><td align='center' style='padding:30px 12px'>
      <table role='presentation' width='100%' cellspacing='0' cellpadding='0' style='max-width:630px;background:#fff'>
        <tr><td style='padding:48px 32px 32px'>
          <div style='text-align:center;margin-bottom:62px'><img src='{{webAppLink}}/assets/images/logos/minified-HULIB-logo.png' width='60' height='70' alt='' style='vertical-align:middle' /><span style='vertical-align:middle;font-size:48px;font-weight:bold;letter-spacing:-2px;color:#0442bf'> HULIB</span></div>
          <h1 style='text-align:center;font-size:28px;margin:0 0 40px'>{{title}}</h1>
          <p style='font-size:16px;line-height:1.6'>{{greeting}} <strong><em>{{recipientName}}</em></strong>,</p>
          <p style='font-size:16px;line-height:1.6'><strong>{{huberName}}</strong> {{confirmationMessage}}</p>
          <p style='font-size:14px;color:#73787c;font-weight:bold;margin-bottom:8px'>{{detailsLabel}}</p>
          <table role='presentation' width='100%' cellspacing='0' cellpadding='10' style='background:#f0f5ff;border:1px solid #84acfc;border-radius:8px;font-size:14px'>
            <tr><td style='color:#73787c'>{{timeLabel}}:</td><td align='right'>{{meetingDate}} | {{meetingTime}}</td></tr>
            <tr><td style='color:#73787c'>{{partnerLabel}}:</td><td align='right'><strong>{{huberName}}</strong></td></tr>
          </table>
          <p style='font-size:16px;line-height:1.6;color:#5f6870'>{{reminder}} <a href='{{meetingUrl}}' style='color:#0442bf;font-style:italic'>{{linkLabel}}</a>.</p>
          <p style='font-size:16px;line-height:1.6;color:#5f6870'>{{signoff}}<br />The HuLib Team</p>
        </td></tr>
        <tr><td style='border-top:1px solid #e3e4e5;padding:32px;text-align:center;color:#73787c;font-size:14px'>
          <p>Website: <a href='{{webAppLink}}' style='color:#0442bf'>HuLib | Landing Page</a></p>
          <p>{{footerDescription}}</p>
          <p style='margin-top:38px'><a href='https://www.facebook.com/hulibvietnam' aria-label='Facebook' style='display:inline-block;width:38px;height:38px;line-height:38px;border-radius:50%;background:#1877f2;color:white;text-decoration:none;font-size:28px;font-weight:bold'>f</a> &nbsp;&nbsp; <a href='https://www.instagram.com/hulibofficial' aria-label='Instagram' style='display:inline-block;width:38px;height:38px;line-height:38px;border-radius:50%;background:#c13584;color:white;text-decoration:none;font-size:24px'>◎</a> &nbsp;&nbsp; <a href='https://www.tiktok.com/@hulibvn' aria-label='TikTok' style='display:inline-block;width:38px;height:38px;line-height:38px;border-radius:50%;background:#000;color:white;text-decoration:none;font-size:24px'>♪</a></p>
        </td></tr>
      </table>
    </td></tr></table>
  </body>
</html>
